<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="620.0" prefWidth="1000.0" styleClass="login-bg" stylesheets="@stable.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.welcomecard.horsestablesystem.controller.LoginController">
   <children>
      <VBox alignment="CENTER" spacing="14.0" maxWidth="380.0" maxHeight="420.0" styleClass="card">
         <children>
            <ImageView fitWidth="110.0" fitHeight="110.0" preserveRatio="true">
               <image><Image url="@logo.png" /></image>
            </ImageView>
            <Label text="Royal Stable System" styleClass="page-title" />
            <Label text="Sign in to manage your stable" styleClass="muted" />
            <TextField fx:id="usernameField" promptText="Username" />
            <PasswordField fx:id="passwordField" promptText="Password" />
            <CheckBox fx:id="rememberCheck" text="Remember me" />
            <Label fx:id="errorLabel" styleClass="error-label" />
            <Button fx:id="loginButton" text="Login" onAction="#login" defaultButton="true" styleClass="primary-button" maxWidth="Infinity" />
         </children>
         <padding><Insets top="30.0" right="30.0" bottom="30.0" left="30.0" /></padding>
      </VBox>
   </children>
</StackPane>
