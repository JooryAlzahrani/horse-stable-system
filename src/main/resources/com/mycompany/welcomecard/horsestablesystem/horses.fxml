<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="620.0" prefWidth="1000.0" styleClass="root-pane" stylesheets="@stable.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.welcomecard.horsestablesystem.controller.HorseController">
   <left>
      <VBox spacing="8.0" styleClass="sidebar" prefWidth="200.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <ImageView fitWidth="38.0" fitHeight="38.0" preserveRatio="true">
                     <image><Image url="@logo_light.png" /></image>
                  </ImageView>
                  <Label text="Royal Stable" styleClass="brand" />
               </children>
            </HBox>
            <Button text="🏠  Dashboard" onAction="#goDashboard" styleClass="nav-button" maxWidth="Infinity" />
            <Button text="🐴  Horses" onAction="#goHorses" styleClass="nav-button nav-active" maxWidth="Infinity" />
            <Button text="👤  Owners" onAction="#goOwners" styleClass="nav-button" maxWidth="Infinity" />
            <Button text="🏚  Stalls" onAction="#goStalls" styleClass="nav-button" maxWidth="Infinity" />
            <Button text="📊  Reports" onAction="#goReports" styleClass="nav-button" maxWidth="Infinity" />
            <Region VBox.vgrow="ALWAYS" />
            <Button text="⎋  Logout" onAction="#logout" styleClass="nav-button" maxWidth="Infinity" />
         </children>
         <padding><Insets top="20.0" right="12.0" bottom="20.0" left="12.0" /></padding>
      </VBox>
   </left>
   <top>
      <HBox alignment="CENTER_LEFT" styleClass="header">
         <children>
            <Label text="Horses" styleClass="page-title" />
         </children>
         <padding><Insets top="16.0" right="24.0" bottom="16.0" left="24.0" /></padding>
      </HBox>
   </top>
   <center>
      <HBox spacing="20.0">
         <children>
            <GridPane hgap="10.0" vgap="10.0" styleClass="card" prefWidth="300.0" minWidth="300.0" alignment="TOP_LEFT">
               <columnConstraints>
                  <ColumnConstraints minWidth="70.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
               </columnConstraints>
               <children>
                  <Label text="Name" GridPane.rowIndex="0" />
                  <TextField fx:id="nameField" promptText="Horse name" GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="Infinity" />
                  <Label text="Breed" GridPane.rowIndex="1" />
                  <ComboBox fx:id="breedCombo" promptText="Select breed" GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="Infinity" />
                  <Label text="Age" GridPane.rowIndex="2" />
                  <TextField fx:id="ageField" promptText="Age in years" GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="Infinity" />
                  <Label text="Gender" GridPane.rowIndex="3" />
                  <HBox spacing="14.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                     <children>
                        <RadioButton fx:id="maleRadio" text="Male" selected="true"><toggleGroup><ToggleGroup fx:id="genderGroup" /></toggleGroup></RadioButton>
                        <RadioButton fx:id="femaleRadio" text="Female" toggleGroup="$genderGroup" />
                     </children>
                  </HBox>
                  <Label text="Owner" GridPane.rowIndex="4" />
                  <ComboBox fx:id="ownerCombo" promptText="Select owner" GridPane.columnIndex="1" GridPane.rowIndex="4" maxWidth="Infinity" />
                  <Label text="Stall" GridPane.rowIndex="5" />
                  <ComboBox fx:id="stallCombo" promptText="Select stall" GridPane.columnIndex="1" GridPane.rowIndex="5" maxWidth="Infinity" />
                  <HBox spacing="10.0" GridPane.columnSpan="2" GridPane.rowIndex="6">
                     <children>
                        <Button fx:id="addButton" text="Add" onAction="#handleAdd" styleClass="primary-button" />
                        <Button fx:id="updateButton" text="Update" onAction="#handleUpdate" styleClass="secondary-button" />
                        <Button fx:id="deleteButton" text="Delete" onAction="#handleDelete" styleClass="danger-button" />
                        <Button text="Clear" onAction="#handleClear" styleClass="secondary-button" />
                     </children>
                  </HBox>
               </children>
               <padding><Insets top="16.0" right="16.0" bottom="16.0" left="16.0" /></padding>
            </GridPane>
            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
               <children>
                  <TextField fx:id="searchField" promptText="🔍  Search horses by name or breed..." styleClass="search-field" />
                  <TableView fx:id="horseTable" onMouseClicked="#handleRowClick" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="idCol" text="ID" prefWidth="50" />
                  <TableColumn fx:id="nameCol" text="Name" prefWidth="120" />
                  <TableColumn fx:id="breedCol" text="Breed" prefWidth="120" />
                  <TableColumn fx:id="ageCol" text="Age" prefWidth="60" />
                  <TableColumn fx:id="genderCol" text="Gender" prefWidth="80" />
                  <TableColumn fx:id="ownerCol" text="Owner" prefWidth="120" />
                  <TableColumn fx:id="stallCol" text="Stall" prefWidth="80" />
               </columns>
               <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
            </TableView>
                  <Label fx:id="statusLabel" styleClass="muted" />
               </children>
            </VBox>
         </children>
         <padding><Insets top="10.0" right="24.0" bottom="24.0" left="24.0" /></padding>
      </HBox>
   </center>
</BorderPane>
