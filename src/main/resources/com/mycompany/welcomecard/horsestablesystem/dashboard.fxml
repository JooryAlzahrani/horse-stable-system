<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="620.0" prefWidth="1000.0" styleClass="root-pane" stylesheets="@stable.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.welcomecard.horsestablesystem.controller.DashboardController">
   <left>
      <VBox spacing="8.0" styleClass="sidebar" prefWidth="200.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <ImageView fitWidth="38.0" fitHeight="38.0" preserveRatio="true">
                     <image><Image url="@logo_light.png" /></image>
                  </ImageView>
                  <Label text="Royal Stable" styleClass="brand" />
               </children>
            </HBox>
            <Button text="🏠  Dashboard" onAction="#goDashboard" styleClass="nav-button nav-active" maxWidth="Infinity" />
            <Button text="🐴  Horses" onAction="#goHorses" styleClass="nav-button" maxWidth="Infinity" />
            <Button text="👤  Owners" onAction="#goOwners" styleClass="nav-button" maxWidth="Infinity" />
            <Button text="🏚  Stalls" onAction="#goStalls" styleClass="nav-button" maxWidth="Infinity" />
            <Button text="📊  Reports" onAction="#goReports" styleClass="nav-button" maxWidth="Infinity" />
            <Region VBox.vgrow="ALWAYS" />
            <Button text="⎋  Logout" onAction="#logout" styleClass="nav-button" maxWidth="Infinity" />
         </children>
         <padding><Insets top="20.0" right="12.0" bottom="20.0" left="12.0" /></padding>
      </VBox>
   </left>
   <top>
      <HBox alignment="CENTER_LEFT" styleClass="header">
         <children>
            <Label text="Dashboard" styleClass="page-title" />
         </children>
         <padding><Insets top="16.0" right="24.0" bottom="16.0" left="24.0" /></padding>
      </HBox>
   </top>
   <center>
      <VBox spacing="20.0">
         <children>
            <Label fx:id="welcomeLabel" text="Welcome back!" styleClass="section-title" />
            <HBox spacing="20.0">
               <children>
            <VBox alignment="CENTER" spacing="4.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="🐴" styleClass="stat-icon" />
                  <Label fx:id="horseCountLabel" text="0" styleClass="stat-number" />
                  <Label text="Total Horses" styleClass="muted" />
               </children>
            </VBox>
            <VBox alignment="CENTER" spacing="4.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="👤" styleClass="stat-icon" />
                  <Label fx:id="ownerCountLabel" text="0" styleClass="stat-number" />
                  <Label text="Owners" styleClass="muted" />
               </children>
            </VBox>
            <VBox alignment="CENTER" spacing="4.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="🏚" styleClass="stat-icon" />
                  <Label fx:id="stallCountLabel" text="0" styleClass="stat-number" />
                  <Label text="Stalls" styleClass="muted" />
               </children>
            </VBox>
            <VBox alignment="CENTER" spacing="4.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="✅" styleClass="stat-icon" />
                  <Label fx:id="freeStallLabel" text="0" styleClass="stat-number" />
                  <Label text="Free Stalls" styleClass="muted" />
               </children>
            </VBox>
               </children>
            </HBox>
            <VBox spacing="10.0" styleClass="card" VBox.vgrow="ALWAYS">
               <children>
                  <Label text="Recently added horses" styleClass="section-title" />
                  <ListView fx:id="recentList" VBox.vgrow="ALWAYS" />
               </children>
               <padding><Insets top="16.0" right="16.0" bottom="16.0" left="16.0" /></padding>
            </VBox>
         </children>
         <padding><Insets top="10.0" right="24.0" bottom="24.0" left="24.0" /></padding>
      </VBox>
   </center>
</BorderPane>
