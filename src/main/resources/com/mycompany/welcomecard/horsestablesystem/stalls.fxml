<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="620.0" prefWidth="1000.0" styleClass="root-pane" stylesheets="@stable.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.welcomecard.horsestablesystem.controller.StallController">
   <left>
      <VBox spacing="8.0" styleClass="sidebar" prefWidth="200.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <ImageView fitWidth="38.0" fitHeight="38.0" preserveRatio="true">
                     <image><Image url="@logo_light.png" /></image>
                  </ImageView>
                  <Label text="Royal Stable" styleClass="brand" />
               </children>
            </HBox>
            <Button text="🏠  Dashboard" onAction="#goDashboard" styleClass="nav-button" maxWidth="Infinity" />
            <Button text="🐴  Horses" onAction="#goHorses" styleClass="nav-button" maxWidth="Infinity" />
            <Button text="👤  Owners" onAction="#goOwners" styleClass="nav-button" maxWidth="Infinity" />
            <Button text="🏚  Stalls" onAction="#goStalls" styleClass="nav-button nav-active" maxWidth="Infinity" />
            <Button text="📊  Reports" onAction="#goReports" styleClass="nav-button" maxWidth="Infinity" />
            <Region VBox.vgrow="ALWAYS" />
            <Button text="⎋  Logout" onAction="#logout" styleClass="nav-button" maxWidth="Infinity" />
         </children>
         <padding><Insets top="20.0" right="12.0" bottom="20.0" left="12.0" /></padding>
      </VBox>
   </left>
   <top>
      <HBox alignment="CENTER_LEFT" styleClass="header">
         <children>
            <Label text="Stalls" styleClass="page-title" />
         </children>
         <padding><Insets top="16.0" right="24.0" bottom="16.0" left="24.0" /></padding>
      </HBox>
   </top>
   <center>
      <HBox spacing="20.0">
         <children>
            <GridPane hgap="10.0" vgap="10.0" styleClass="card" prefWidth="300.0" minWidth="300.0" alignment="TOP_LEFT">
               <columnConstraints>
                  <ColumnConstraints minWidth="70.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
               </columnConstraints>
               <children>
                  <Label text="Number" GridPane.rowIndex="0" />
                  <TextField fx:id="numberField" promptText="e.g. A-01" GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="Infinity" />
                  <Label text="Capacity" GridPane.rowIndex="1" />
                  <TextField fx:id="capacityField" promptText="Number of horses" GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="Infinity" />
                  <Label text="Location" GridPane.rowIndex="2" />
                  <ComboBox fx:id="locationCombo" promptText="Select block" GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="Infinity" />
                  <HBox spacing="10.0" GridPane.columnSpan="2" GridPane.rowIndex="3">
                     <children>
                        <Button fx:id="addButton" text="Add" onAction="#handleAdd" styleClass="primary-button" />
                        <Button fx:id="updateButton" text="Update" onAction="#handleUpdate" styleClass="secondary-button" />
                        <Button fx:id="deleteButton" text="Delete" onAction="#handleDelete" styleClass="danger-button" />
                        <Button text="Clear" onAction="#handleClear" styleClass="secondary-button" />
                     </children>
                  </HBox>
               </children>
               <padding><Insets top="16.0" right="16.0" bottom="16.0" left="16.0" /></padding>
            </GridPane>
            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
               <children>
                  <TextField fx:id="searchField" promptText="🔍  Search stalls by number or location..." styleClass="search-field" />
                  <TableView fx:id="stallTable" onMouseClicked="#handleRowClick" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="idCol" text="ID" prefWidth="50" />
                  <TableColumn fx:id="numberCol" text="Number" prefWidth="90" />
                  <TableColumn fx:id="capacityCol" text="Capacity" prefWidth="90" />
                  <TableColumn fx:id="locationCol" text="Location" prefWidth="140" />
               </columns>
               <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
            </TableView>
                  <Label fx:id="statusLabel" styleClass="muted" />
               </children>
            </VBox>
         </children>
         <padding><Insets top="10.0" right="24.0" bottom="24.0" left="24.0" /></padding>
      </HBox>
   </center>
</BorderPane>
